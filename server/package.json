{
  "name": "imovies-server",
  "version": "1.0.0",
  "description": "IMovies — Secure REST API & Cinema Ticket Booking Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "cross-env PORT=5001 node src/server.js",
    "dev": "cross-env PORT=5001 nodemon src/server.js",
    "seed": "node scripts/seedDatabase.js",
    "test": "vitest run --reporter=verbose"
  },
  "keywords": [
    "imovies",
    "express",
    "mongodb",
    "mongoose",
    "cinema-booking",
    "rest-api"
  ],
  "author": "IMovies Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0",
    "vitest": "^3.0.6"
