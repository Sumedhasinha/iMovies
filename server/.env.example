# Environment Variables Template for IMovies Backend Server
NODE_ENV=development
PORT=5001

# MongoDB Connection String (Atlas or Local)
# e.g., mongodb://127.0.0.1:27017/imovies or mongodb+srv://<user>:<password>@cluster.mongodb.net/imovies
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JWT Authentication Configuration
JWT_SECRET=your_jwt_strong_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS Whitelisting
CLIENT_ORIGIN=http://localhost:5173

# Initial Seed Admin Account (Used strictly for dev database seeding)
ADMIN_NAME=IMovies Executive Admin
ADMIN_EMAIL=admin@imovies.vip
ADMIN_PASSWORD=AdminPass2026!
